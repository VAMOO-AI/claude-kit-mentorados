{
  "language": "portuguese",
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(awk:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(command -v *)",
      "Bash(jq:*)",
      "Bash(env)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(sleep:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git remote -v)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(npm run:*)",
      "Bash(npm test)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vite:*)",
      "Bash(npx next:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prisma:*)",
      "Bash(npx supabase:*)",
      "Bash(npx --version)",
      "Bash(node --version)",
      "Bash(node --check:*)",
      "Bash(python3 -m json.tool)",
      "Bash(python3 --version)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun --version)",
      "Bash(bunx tsc:*)",
      "Bash(bunx eslint:*)",
      "Bash(bunx vitest:*)",
      "Bash(bunx playwright:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm install:*)",
      "Bash(supabase --version)",
      "Bash(vercel whoami:*)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Read(**/.env)",
        "Read(~/.ssh/**)",
        "Read(**/id_rsa*)",
        "Read(**/id_ed25519*)",
        "Read(**/*.pem)",
        "Read(**/serviceAccountKey.json)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(supabase login:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(vercel login:*)"
    ]
  }
}
