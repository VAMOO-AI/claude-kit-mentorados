{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/path-rules.sh\""
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-monitor-ci.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-modificados.sh\" anota"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-session.sh\" touch"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-session.sh\" touch"
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/scripts/warn-branch-behind.sh\""
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/scripts/warn-worktree-stale.sh\""
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/scripts/warn-kit-updated.sh\""
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/warn-skills-projeto.sh\""
          },
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/dotcontext-session.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-devolve.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-prompt.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-snapshot.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-session.sh\" end"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-stop.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/.team-manifest\" ] && [ \"${KIT_VAMOO_HOOKS:-}\" != 1 ] && exit 0; bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lint-modificados.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
